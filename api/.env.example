# Copie ce fichier en .env puis adapte les valeurs.
# Le fichier .env n'est jamais commité : il contient des secrets.

NODE_ENV=development
PORT=3000

# Base PostgreSQL lancée par docker compose (voir docker-compose.yml à la racine)
DATABASE_URL="postgresql://kartnet:kartnet@localhost:5432/kartnet?schema=public"

# Secret de signature des tokens JWT : 32 caractères minimum.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplace-moi-par-un-long-secret-aleatoire-de-48-octets"
JWT_EXPIRES_IN=7d

# Adresse publique de l'API, utilisée pour construire l'URL des photos.
# Sur téléphone, mets l'IP de ton PC sur le Wi-Fi (ex. http://192.168.1.20:3000), pas localhost.
PUBLIC_URL=http://localhost:3000

# Origines autorisées (CORS), séparées par des virgules. * = toutes.
CORS_ORIGIN=*

# Stockage des photos : "local" (dossier uploads/). "cloudinary" pourra être ajouté plus tard.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

LOG_LEVEL=info
